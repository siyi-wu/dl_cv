{
  "data": {
    "data_dir": "data/FashionMNIST/raw",
    "split_seed": 42,
    "train_size": 50000,
    "batch_size": 128,
    "num_workers": 0
  },
  "visualization": {
    "output_dir": "outputs/data_visualization",
    "figure_dpi": 140
  },
  "training": {
    "output_dir": "outputs/linear",
    "epochs": 20,
    "learning_rate": 0.1,
    "seed": 42,
    "device": "cuda"
  },
  "evaluation": {
    "batch_size": 256,
    "typical_error_count": 16
  },
  "gradient_check": {
    "output_path": "outputs/gradient_check/result.json",
    "batch_size": 4,
    "hidden_size": 5,
    "epsilon": 0.00001,
    "checks_per_parameter": 20,
    "seed": 42
  },
  "comparison": {
    "output_dir": "outputs/model_comparison",
    "models": [
      "linear",
      "two_linear",
      "mlp_relu"
    ],
    "hidden_size": 128
  },
  "diagnosis": {
    "output_dir": "outputs/training_diagnosis",
    "model": "mlp_relu",
    "early_stopping_patience": 3
  }
}
