        <mxCell id="title" value="&lt;b&gt;实验二 · EnhancedUNet 噪声预测网络&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="850" height="44" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="3,327,553 parameters · base channels 48 · time dim 192 · AdaGN · multi-scale 4-head attention · 张量标注为 C × H × W" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1120" height="30" as="geometry"/></mxCell>
        <mxCell id="badge" value="&lt;b&gt;3.33M&lt;/b&gt;&lt;br&gt;论文启发改进" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=16;fontColor=#274E13;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1360" y="35" width="170" height="60" as="geometry"/></mxCell>

        <mxCell id="time" value="&lt;b&gt;时间条件 t&lt;/b&gt;&lt;br&gt;Sinusoidal Embedding 192-d → Linear → SiLU → Linear&lt;br&gt;&lt;font color=&quot;#6B4C9A&quot;&gt;每个 AdaptiveResBlock 将时间向量映射为 2C：逐通道 scale s(t) 与 shift b(t)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=15;fontColor=#3D2C5E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="390" y="120" width="790" height="95" as="geometry"/></mxCell>
        <mxCell id="adagnFormula" value="&lt;b&gt;AdaGN(h,t)&lt;/b&gt; = (1 + s(t)) ⊙ GroupNorm(h) + b(t)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9673A6;fontSize=15;fontColor=#4C1D95;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="535" y="230" width="500" height="45" as="geometry"/></mxCell>

        <mxCell id="encoderLabel" value="ENCODER · 双残差块 + 多尺度注意力" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=16;fontColor=#2F5597;" vertex="1" parent="1"><mxGeometry x="45" y="300" width="520" height="30" as="geometry"/></mxCell>
        <mxCell id="input" value="&lt;b&gt;带噪图像 xₜ&lt;/b&gt;&lt;br&gt;1 × 28 × 28&lt;br&gt;Conv 3×3&lt;br&gt;&lt;b&gt;→ 48 × 28 × 28&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="45" y="350" width="150" height="130" as="geometry"/></mxCell>
        <mxCell id="enc28" value="&lt;b&gt;AdaptiveResBlock × 2&lt;/b&gt;&lt;br&gt;48 → 48 → 48&lt;br&gt;48 × 28 × 28&lt;br&gt;&lt;font color=&quot;#2F855A&quot;&gt;保存 Skip S₁&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="245" y="350" width="190" height="130" as="geometry"/></mxCell>
        <mxCell id="down1" value="&lt;b&gt;Downsample 1&lt;/b&gt;&lt;br&gt;Conv 4×4, stride 2&lt;br&gt;48 × 14 × 14" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="485" y="365" width="160" height="100" as="geometry"/></mxCell>
        <mxCell id="enc14" value="&lt;b&gt;AdaptiveResBlock × 2&lt;/b&gt;&lt;br&gt;48 → 96 → 96&lt;br&gt;&lt;font color=&quot;#6B4C9A&quot;&gt;4-head Attention · 14×14&lt;/font&gt;&lt;br&gt;96 × 14 × 14&lt;br&gt;&lt;font color=&quot;#2F855A&quot;&gt;保存 Skip S₂&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="695" y="340" width="205" height="150" as="geometry"/></mxCell>
        <mxCell id="down2" value="&lt;b&gt;Downsample 2&lt;/b&gt;&lt;br&gt;Conv 4×4, stride 2&lt;br&gt;96 × 7 × 7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="950" y="365" width="160" height="100" as="geometry"/></mxCell>
        <mxCell id="middle" value="&lt;b&gt;BOTTLENECK · 7 × 7&lt;/b&gt;&lt;br&gt;AdaptiveResBlock: 96 → 192&lt;br&gt;&lt;font color=&quot;#6B4C9A&quot;&gt;4-head Spatial Attention&lt;/font&gt;&lt;br&gt;AdaptiveResBlock: 192 → 192" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1160" y="340" width="255" height="150" as="geometry"/></mxCell>

        <mxCell id="decoderLabel" value="DECODER · Skip 拼接 + 双残差块 + 14×14 注意力" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=16;fontColor=#2F5597;" vertex="1" parent="1"><mxGeometry x="45" y="615" width="650" height="30" as="geometry"/></mxCell>
        <mxCell id="up2" value="&lt;b&gt;Upsample 2&lt;/b&gt;&lt;br&gt;ConvTranspose 4×4&lt;br&gt;192 → 96&lt;br&gt;96 × 14 × 14" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="950" y="670" width="160" height="120" as="geometry"/></mxCell>
        <mxCell id="dec14" value="&lt;b&gt;Concat S₂ + AdaRes × 2&lt;/b&gt;&lt;br&gt;192 → 96 → 96&lt;br&gt;&lt;font color=&quot;#6B4C9A&quot;&gt;4-head Attention · 14×14&lt;/font&gt;&lt;br&gt;96 × 14 × 14" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="695" y="660" width="205" height="140" as="geometry"/></mxCell>
        <mxCell id="up1" value="&lt;b&gt;Upsample 1&lt;/b&gt;&lt;br&gt;ConvTranspose 4×4&lt;br&gt;96 → 48&lt;br&gt;48 × 28 × 28" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="485" y="670" width="160" height="120" as="geometry"/></mxCell>
        <mxCell id="dec28" value="&lt;b&gt;Concat S₁ + AdaRes × 2&lt;/b&gt;&lt;br&gt;96 → 48 → 48&lt;br&gt;48 × 28 × 28" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="245" y="670" width="190" height="120" as="geometry"/></mxCell>
        <mxCell id="output" value="&lt;b&gt;预测噪声 εθ(xₜ,t)&lt;/b&gt;&lt;br&gt;GroupNorm → SiLU&lt;br&gt;zero-init Conv 3×3&lt;br&gt;&lt;b&gt;→ 1 × 28 × 28&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="45" y="660" width="150" height="140" as="geometry"/></mxCell>

        <mxCell id="block" value="&lt;b&gt;AdaptiveResBlock 内部&lt;/b&gt;&lt;br&gt;&lt;br&gt;GroupNorm → SiLU → Conv3×3&lt;br&gt;AdaGN(scale, shift)&lt;br&gt;SiLU → Dropout 0.1&lt;br&gt;zero-init Conv3×3 → + Residual" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;align=left;spacingLeft=14;fontSize=14;fontColor=#333333;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1160" y="635" width="300" height="185" as="geometry"/></mxCell>
        <mxCell id="why" value="&lt;b&gt;相对 MiniUNet 的四类改进&lt;/b&gt;&lt;br&gt;① 通道 32/64/128 → 48/96/192　② 时间加法 → AdaGN 调制　③ 每尺度 1 个 → 2 个残差块　④ 单尺度单头 → 双尺度 4 头注意力；残差末端、注意力投影和输出层采用零初始化。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=14;fontSize=14;fontColor=#594A05;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="190" y="900" width="1190" height="75" as="geometry"/></mxCell>

